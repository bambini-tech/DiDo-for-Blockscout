# Blockscout PRO API key -- https://dev.blockscout.com
# One key covers every chain. Never commit a real key.
BLOCKSCOUT_API_KEY=

# Optional
PORT=3000
# Proxy hops in front of the server (Railway: 1). 0 when nothing proxies it.
TRUST_PROXY_HOPS=1
# The entry board (the start page's garden): 0 turns it off. It reads market
# data on a 4-hour beat; BOARD_MAX_READS caps engine reads per round (default 60).
BOARD_ENABLED=1
BOARD_MAX_READS=60
# The Blockscout plan the key is on: builder (default: 15 req/s, 100M credits a
# month) or free (5 req/s, 100k a day). Sets the request rate, the daily credit
# brake and how deep holder maps read. BLOCKSCOUT_RPS and
# BLOCKSCOUT_DAILY_CREDIT_BRAKE override one knob each.
BLOCKSCOUT_PLAN=builder
