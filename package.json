{
  "name": "dido-for-blockscout",
  "version": "0.11.3",
  "private": true,
  "description": "DiDo for Blockscout: who really holds a token. Holder map, wallet clusters and wallet journeys, built on the Blockscout PRO API.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node web/build.mjs",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "verify-chains": "node tools/verify-chains.mjs"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
